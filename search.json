---
layout: null
---
[
{% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {% if post.undated %}null{% else %}{{ post.date | date: "%b %Y" | jsonify }}{% endif %},
    "publication": {{ post.publication | default: "" | jsonify }},
    "excerpt": {{ post.excerpt | default: "" | strip_html | strip_newlines | truncate: 200 | jsonify }},
    "categories": {{ post.categories | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
